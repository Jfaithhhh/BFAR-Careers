rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : '';
    }

    function hasUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return hasUserDoc()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    // Strictly HR Admin / HRMPSB: explicit hr_admin role on users/{uid} OR designated admin email
    function isHrAdmin() {
      return isSignedIn()
        && (
          userRole() == 'hr_admin'
          || authEmail() == 'jaiciervo7@gmail.com'
        );
    }

    function isValidAppSize() {
      return request.resource.size() < 250000;
    }

    function isValidOtpCode(code) {
      return code is string && code.matches('^[0-9]{6}$');
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isHrAdmin());

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['bfar_employee', 'external_applicant']
        && request.resource.data.email is string
        && request.resource.data.emailVerified is bool
        && (
          (
            request.resource.data.role == 'bfar_employee'
            && (
              request.resource.data.email.matches('.*@bfar\\.da\\.gov\\.ph$')
              || request.resource.data.email.matches('.*@gmail\\.com$')
            )
          )
          || (
            request.resource.data.role == 'external_applicant'
            && !request.resource.data.email.matches('.*@bfar\\.da\\.gov\\.ph$')
          )
        );

      allow update: if isHrAdmin()
        || (
          isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && (
            resource.data.role != 'bfar_employee'
            || !request.resource.data.email.matches('.*@bfar\\.da\\.gov\\.ph$')
            || request.resource.data.email.matches('.*@bfar\\.da\\.gov\\.ph$')
          )
        );

      allow delete: if isHrAdmin();
    }

    // Username uniqueness check and registration mapping
    match /usernames/{usernameKey} {
      allow read: if true;
      allow create: if request.resource.data.username is string
        && request.resource.data.email is string
        && request.resource.data.uid is string;
      allow update, delete: if isHrAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // OTP verification records used by sendExternalApplicantOtp & validateOtpRecord
    match /otp_verifications/{docId} {
      allow create, update: if request.resource.data.email is string
        && isValidOtpCode(request.resource.data.code)
        && request.resource.data.expiresAt is number
        && request.resource.data.verified is bool;
      allow read: if isHrAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isHrAdmin();
    }

    // Queued email notifications for OTP delivery
    match /mail/{mailId} {
      allow create: if request.resource.data.to is list
        && request.resource.data.to.size() > 0
        && request.resource.data.message is map;
      allow read, update, delete: if isHrAdmin();
    }

    // Legacy OTP collection if still referenced anywhere
    match /email_otps/{emailKey} {
      allow read, create, update, delete: if isHrAdmin();
    }

    // Job vacancies: public read for careers portal; write restricted to HR Admin
    match /job_vacancies/{jobId} {
      allow read: if true;
      allow create, update, delete: if isHrAdmin();
    }

    // Applications: signed-in users can create/read/update own application; HR Admin has full access
    match /applications/{appId} {
      allow create: if isSignedIn()
        && isValidAppSize()
        && (
          isHrAdmin()
          || request.resource.data.applicantUid == request.auth.uid
          || (
            authEmail() != ''
            && request.resource.data.pdsData.personalInfo.email == authEmail()
          )
        );

      allow read: if isHrAdmin()
        || (
          isSignedIn()
          && (
            resource.data.applicantUid == request.auth.uid
            || (
              authEmail() != ''
              && resource.data.pdsData.personalInfo.email == authEmail()
            )
          )
        );

      allow update: if isHrAdmin()
        || (
          isSignedIn()
          && isValidAppSize()
          && (
            resource.data.applicantUid == request.auth.uid
            || (
              authEmail() != ''
              && resource.data.pdsData.personalInfo.email == authEmail()
            )
          )
        );

      allow delete: if isHrAdmin();
    }

    // Internal employees: signed-in users can read; write/delete restricted to HR Admin
    match /internal_employees/{empId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isHrAdmin();
    }

    // Authorized staff: signed-in users can read; write restricted to HR Admin
    match /authorized_staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if isHrAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}